{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./**/.env)",
      "Read(./.private/**)",
      "Read(./**/*.pem)",
      "Read(./**/*service-account*.json)",
      "Read(./node_modules/**)",
      "Read(./data/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/tools/guard/claude-hooks.mjs\" session-start" } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/tools/guard/claude-hooks.mjs\" prompt" } ] }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit",
        "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/tools/guard/claude-hooks.mjs\" pre-tool" } ]
      }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/tools/guard/claude-hooks.mjs\" stop" } ] }
    ]
  }
}
