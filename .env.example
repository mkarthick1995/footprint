# Copy to .env (npm run setup does it). NEVER put real values in this file.
# In Cloud Run these come from Secret Manager / service env vars.

# Gemini API key (server-side only; browser gets ephemeral tokens)
GEMINI_API_KEY=
# Gemini model IDs change often — confirm in AI Studio (ADR-029)
GEMINI_LIVE_MODEL=
GEMINI_SCAN_MODEL=

# Google Cloud
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=asia-southeast1

# Google Maps Platform (restrict by HTTP referrer + API in the console)
GOOGLE_MAPS_API_KEY=

# Firestore
FIRESTORE_DATABASE=(default)

# API
ALLOWED_ORIGINS=http://localhost:5173
PORT=8080
