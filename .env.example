# Copy to .env (npm run setup does it). NEVER put real values in this file.
# In Cloud Run these come from service env vars / Secret Manager; Gemini auth uses the service account (ADR-030).

# Google Cloud
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=asia-southeast1

# Gemini via Vertex AI (ADR-030). Local dev authenticates with `gcloud auth application-default login`.
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_SCAN_MODEL=gemini-3.8-flash
GEMINI_SCAN_LOCATION=global
GEMINI_LIVE_MODEL=gemini-live-2.5-flash-native-audio
GEMINI_LIVE_LOCATION=us-central1
# Unused on the Vertex route (Gemini Developer API needs AI Studio prepaid credit) — leave empty
GEMINI_API_KEY=

# Google Maps Platform (browser key, restricted to Maps JavaScript + Routes APIs; add HTTP-referrer restriction)
GOOGLE_MAPS_API_KEY=

# Firestore
FIRESTORE_DATABASE=(default)

# API
ALLOWED_ORIGINS=http://localhost:5173
PORT=8080
